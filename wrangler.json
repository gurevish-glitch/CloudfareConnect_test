{
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "worker-previews-starter",
	"upload_source_maps": true,
	// Production settings live at the top level.
	"vars": {
		"ENVIRONMENT": "production"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "ec90d4f3-a681-4067-b838-362fa862b5a6",
			"database_name": "activity-log-db"
		}
	],
	"observability": {
		"enabled": true
	},
	// Preview settings live here. Previews don't inherit production vars or
	// bindings: add Preview-only bindings (like the Preview D1 database) here.
	// A Preview D1 database's migrations are applied through
	// wrangler.preview-migrations.jsonc, which must point at the same database.
	"previews": {
		"vars": {
			"ENVIRONMENT": "preview"
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "workshop-preview-db",
				"database_id": "515f02ae9b8ea4062c4e8eb0263124da"
			}
		],
		"observability": {
			"enabled": true
		}
	}
}
